# ============================================================
# Python / Backend (FastAPI)
# ============================================================
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
*.egg-info/

# Environment & secrets — JANGAN pernah commit .env (isinya password DB,
# API key Ollama/OpenAI, dsb). Cukup commit .env.example sebagai template.
.env
.env.*
!.env.example

# Data hasil scraping/cache lokal (bukan source code, regenerable)
backend/scratch/
backend/data/**/*.json
backend/data/**/*.csv
*.log

# Database lokal (kalau pernah pakai SQLite untuk testing)
*.sqlite3
*.db

# ============================================================
# iOS / Xcode / SwiftUI (SahamIndo)
# ============================================================
# Build products
DerivedData/
build/
*.xcarchive

# User-specific Xcode settings (jangan commit, beda tiap developer)
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods (kalau dipakai)
Pods/

# ============================================================
# Editor / OS
# ============================================================
.DS_Store
*.zip
.vscode/
.idea/

# ============================================================
# Docker
# ============================================================
docker-compose.override.yml
